# Credentials: never commit. They live in the shared secrets directory, not in any repository.
# *.env catches market-data.env and paper-accounts.env too: the README names those files, which
# makes copying them in here an easy mistake, and they must not be committable when it happens.
.env
.env.*
*.env
!*.env.example

# Local research output: account snapshots, broker records, saved prompts and model responses.
/reports/
/logs/

__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.tmp
